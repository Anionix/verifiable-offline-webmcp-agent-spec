        "expression": "approvalDigest == digest(normalizedIntent)"
      },
      {
        "id": "quote",
        "expression": "quote.validUntil >= now"
      }
    ],
    "postconditions": [
      {
        "id": "receipt",
        "expression": "receipt.intentId == intentId"
      },
      {
        "id": "at-most-once",
        "expression": "countEconomicEffects(intentId) <= 1"
