          "@id": "urn:uuid:2791987b-30bb-5a18-93c8-58f8c88aee80"
        }
      ],
      "normativeLevel": "MUST"
    },
    {
      "@id": "urn:uuid:d96922b0-3849-5196-bf45-0550be1dd998",
      "@type": "spec:Requirement",
      "spec:shortId": "REQ-POLICY-008",
      "uuidV5": "d96922b0-3849-5196-bf45-0550be1dd998",
      "uuidV7": "01a04291-b3d1-7fe6-9449-df5a93d1b615",
      "title": [
        {
          "@value": "LLM、tool output、web contentだけでauthorityを増加させてはならない。",
          "@language": "ja"
        },
        {
          "@value": "Authority MUST NOT increase solely because of LLM output, tool output, o",
          "@language": "en"
        }
      ],
      "created": "2026-08-27T09:34:00Z",
      "modified": "2026-08-27T09:34:00Z",
