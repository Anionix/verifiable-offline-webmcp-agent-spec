      "uuidV7": "01a04291-b3c9-783f-9300-f580843cc236",
      "title": [
        {
          "@value": "観測可能なwriteはread-backでpostconditionを確認すべきである。",
          "@language": "ja"
        },
        {
          "@value": "Observable writes SHOULD verify postconditions by read-back.",
          "@language": "en"
        }
      ],
      "created": "2026-08-27T09:34:00Z",
      "modified": "2026-08-27T09:34:00Z",
