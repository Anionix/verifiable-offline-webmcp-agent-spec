    {
      "@id": "urn:uuid:5fd344e3-7eb1-5081-80c2-eecb47ee0b95",
      "@type": "spec:ArchitectureDecision",
      "spec:shortId": "ADR-006",
      "uuidV5": "5fd344e3-7eb1-5081-80c2-eecb47ee0b95",
      "uuidV7": "01a04291-b3ae-732a-aebe-9cbf1bfc2ec1",
      "title": [
        {
          "@value": "UNKNOWN/timeoutではmutation retryよりreconciliationを先に行う",
          "@language": "ja"
        },
        {
          "@value": "Reconcile UNKNOWN/timeouts before any mutating retry",
          "@language": "en"
        }
      ],
      "created": "2026-08-27T09:34:00Z",
      "modified": "2026-08-27T09:34:00Z",
      "sourceRefs": [
        {
          "@id": "urn:uuid:f5c97a48-75c1-5e0f-82e6-c989fdc2ea7d"
        }
      ]
    },
    {
      "@id": "urn:uuid:e0d4d877-a38f-5087-b3e6-51426a09bef9",
      "@type": "spec:ArchitectureDecision",
      "spec:shortId": "ADR-007",
      "uuidV5": "e0d4d877-a38f-5087-b3e6-51426a09bef9",
      "uuidV7": "01a04291-b3af-7472-9ddd-f978c02c446d",
      "title": [
        {
          "@value": "イベント列を真実の一次記録、snapshotを派生cacheとする",
          "@language": "ja"
        },
        {
          "@value": "Treat the event stream as the source record and snapshots as derived caches",
          "@language": "en"
        }
      ],
      "created": "2026-08-27T09:34:00Z",
      "modified": "2026-08-27T09:34:00Z",
      "sourceRefs": [
        {
          "@id": "urn:uuid:a6ebf827-b311-50da-be6e-c0bbe61838f5"
