      "uuidV7": "01a04291-b3b1-7964-9760-0199fdb15697",
      "title": [
        {
          "@value": "オフライン中はdeviceごとの署名chainを作り、同期後にglobal sequenceを付与する",
          "@language": "ja"
        },
        {
          "@value": "Create a signed chain per device offline and assign global sequence after synchronization",
          "@language": "en"
        }
      ],
