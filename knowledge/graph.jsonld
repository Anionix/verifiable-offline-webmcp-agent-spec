          "@id": "urn:uuid:1dbda155-9584-5df2-bead-cd6aa3279b18"
        }
      ],
      "latex": "\\min_{\\theta,R,V,z}J\\quad\\text{s.t. }P_{good}\\ge S_{min},\\;P_{bad}\\le\\epsilon_{bad},\\;P_{dup}\\le\\epsilon_{dup},\\;E[T]\\le L_{max}"
    },
