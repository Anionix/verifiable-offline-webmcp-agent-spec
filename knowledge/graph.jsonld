      ]
    },
    {
      "@id": "urn:uuid:c9813073-a03e-578c-bd3c-e126ad3535ea",
      "@type": "spec:ArchitectureDecision",
      "spec:shortId": "ADR-005",
      "uuidV5": "c9813073-a03e-578c-bd3c-e126ad3535ea",
      "uuidV7": "01a04291-b3ad-73c7-b06c-d02a9e316fe3",
