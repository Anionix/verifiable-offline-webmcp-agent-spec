    {
      "@id": "urn:uuid:9b62b0e4-3ee5-51df-b7bf-10ba11d6c4b2",
      "@type": "spec:Requirement",
      "spec:shortId": "REQ-FORMAL-001",
      "uuidV5": "9b62b0e4-3ee5-51df-b7bf-10ba11d6c4b2",
      "uuidV7": "01a04291-b3f5-790e-9749-747c6ed886b8",
      "title": [
        {
          "@value": "未承認実行、二重効果、未検証commit、ambiguous retryをTLA+ invariantとして定義しなければならない。",
          "@language": "ja"
        },
        {
          "@value": "Unauthorized execution, double effects, unverified commit, and ambiguous",
          "@language": "en"
        }
      ],
      "created": "2026-08-27T09:34:00Z",
      "modified": "2026-08-27T09:34:00Z",
      "sourceRefs": [
        {
          "@id": "urn:uuid:f5c97a48-75c1-5e0f-82e6-c989fdc2ea7d"
        }
      ],
      "normativeLevel": "MUST"
    },
    {
      "@id": "urn:uuid:4a7c98bf-cc25-5097-b54e-f6616021c390",
      "@type": "spec:Requirement",
      "spec:shortId": "REQ-FORMAL-002",
      "uuidV5": "4a7c98bf-cc25-5097-b54e-f6616021c390",
      "uuidV7": "01a04291-b3f6-7d6c-bb0f-b118b80f5e21",
      "title": [
        {
          "@value": "各安全guardを意図的に破壊したmutation modelがcounterexampleを生成することを確認しなければならない。",
          "@language": "ja"
        },
        {
          "@value": "A mutation model that deliberately breaks each safety guard MUST produce",
          "@language": "en"
        }
      ],
      "created": "2026-08-27T09:34:00Z",
      "modified": "2026-08-27T09:34:00Z",
      "sourceRefs": [
        {
          "@id": "urn:uuid:f5c97a48-75c1-5e0f-82e6-c989fdc2ea7d"
        }
      ],
      "normativeLevel": "MUST"
    },
    {
      "@id": "urn:uuid:c1f0c7bf-b94b-5e09-8c2f-421ef46bd6d3",
      "@type": "spec:Requirement",
      "spec:shortId": "REQ-SLO-001",
      "uuidV5": "c1f0c7bf-b94b-5e09-8c2f-421ef46bd6d3",
      "uuidV7": "01a04291-b3f7-759b-891e-9bd460980b31",
      "title": [
        {
          "@value": "qT、qB、qR、qHは非負で合計1でなければならない。",
          "@language": "ja"
        },
        {
          "@value": "qT, qB, qR, and qH MUST be nonnegative and sum to one.",
          "@language": "en"
        }
      ],
      "created": "2026-08-27T09:34:00Z",
      "modified": "2026-08-27T09:34:00Z",
      "sourceRefs": [
        {
          "@id": "urn:uuid:1dbda155-9584-5df2-bead-cd6aa3279b18"
