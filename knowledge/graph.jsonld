    },
    {
      "@id": "urn:uuid:003a04af-cfb1-5ee4-9c26-9e308e521f37",
      "@type": "spec:ArchitectureDecision",
      "spec:shortId": "ADR-004",
      "uuidV5": "003a04af-cfb1-5ee4-9c26-9e308e521f37",
      "uuidV7": "01a04291-b3ac-7a3e-a3be-a9cbe5ec9223",
      "title": [
        {
          "@value": "全実装はCanonical IRを共有し整数演算で判定する",
          "@language": "ja"
        },
        {
          "@value": "All implementations share Canonical IR and use integer decision arithmetic",
          "@language": "en"
        }
