    },
    {
      "@id": "urn:uuid:17f9794a-6aec-5989-b317-6d50fd8f11fe",
      "@type": "spec:Formula",
      "spec:shortId": "F-602",
      "uuidV5": "17f9794a-6aec-5989-b317-6d50fd8f11fe",
      "uuidV7": "01a04291-b3a3-7ef4-bc6d-eb192a1aefcc",
      "title": [
        {
          "@value": "有限retry幾何級数",
          "@language": "ja"
        },
        {
          "@value": "Finite retry geometric series",
          "@language": "en"
        }
      ],
      "created": "2026-08-27T09:34:00Z",
      "modified": "2026-08-27T09:34:00Z",
      "latex": "G_R=\\sum_{k=0}^Rq_R^k=\\frac{1-q_R^{R+1}}{1-q_R}"
    },
    {
      "@id": "urn:uuid:e15536c9-7e19-5023-bb43-df58da80d2c5",
      "@type": "spec:Formula",
      "spec:shortId": "F-603",
      "uuidV5": "e15536c9-7e19-5023-bb43-df58da80d2c5",
      "uuidV7": "01a04291-b3a4-7f08-8ca2-9e24d2ff8422",
      "title": [
        {
          "@value": "正commit確率",
          "@language": "ja"
        },
        {
          "@value": "Good commit probability",
          "@language": "en"
        }
      ],
      "created": "2026-08-27T09:34:00Z",
      "modified": "2026-08-27T09:34:00Z",
      "latex": "P_{good}=q_T[1-\\beta(\\theta,V)]G_R"
    },
    {
      "@id": "urn:uuid:cb2d0862-38e0-53b0-ab04-5f649fd7486d",
      "@type": "spec:Formula",
      "spec:shortId": "F-604",
      "uuidV5": "cb2d0862-38e0-53b0-ab04-5f649fd7486d",
      "uuidV7": "01a04291-b3a5-7c28-a30d-abdd54b6944e",
      "title": [
        {
          "@value": "誤commit確率",
          "@language": "ja"
        },
        {
          "@value": "Bad commit probability",
          "@language": "en"
        }
      ],
      "created": "2026-08-27T09:34:00Z",
      "modified": "2026-08-27T09:34:00Z",
      "latex": "P_{bad}=q_B\\alpha(\\theta,V)G_R"
    },
    {
      "@id": "urn:uuid:6b1bd420-6f96-52c4-abea-9a4ab3227658",
      "@type": "spec:Formula",
      "spec:shortId": "F-605",
      "uuidV5": "6b1bd420-6f96-52c4-abea-9a4ab3227658",
      "uuidV7": "01a04291-b3a6-7004-8ce0-2fa7930dd04c",
      "title": [
        {
          "@value": "人間退避確率",
          "@language": "ja"
        },
        {
          "@value": "Human/non-commit probability",
          "@language": "en"
        }
      ],
      "created": "2026-08-27T09:34:00Z",
      "modified": "2026-08-27T09:34:00Z",
      "latex": "P_H=[q_H+q_T\\beta+q_B(1-\\alpha)]G_R+q_R^{R+1}"
    },
    {
      "@id": "urn:uuid:50c98ea5-670f-5394-af5e-98599eb24a5e",
      "@type": "spec:Formula",
      "spec:shortId": "F-606",
      "uuidV5": "50c98ea5-670f-5394-af5e-98599eb24a5e",
      "uuidV7": "01a04291-b3a7-795c-8c28-38915ef9744f",
      "title": [
        {
          "@value": "重複効果確率",
          "@language": "ja"
        },
        {
          "@value": "Duplicate-effect probability",
          "@language": "en"
        }
      ],
      "created": "2026-08-27T09:34:00Z",
      "modified": "2026-08-27T09:34:00Z",
      "latex": "P_{dup}=\\frac{\\eta q_R[1-(q_R(1-\\eta))^R]}{1-q_R(1-\\eta)}"
    },
    {
      "@id": "urn:uuid:1a356746-dc65-517f-8fb6-e794f84ff4c5",
      "@type": "spec:Formula",
      "spec:shortId": "F-607",
      "uuidV5": "1a356746-dc65-517f-8fb6-e794f84ff4c5",
      "uuidV7": "01a04291-b3a8-7f32-a429-f813b8f3445f",
