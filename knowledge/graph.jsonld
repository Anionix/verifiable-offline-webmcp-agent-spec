        {
          "@id": "urn:uuid:0040f552-6e8a-555a-8d77-ff88cf190932"
        }
      ],
      "normativeLevel": "MUST"
    },
    {
      "@id": "urn:uuid:4c09d56e-113d-5360-97f9-eece170c3188",
      "@type": "spec:Requirement",
      "spec:shortId": "REQ-POLICY-007",
      "uuidV5": "4c09d56e-113d-5360-97f9-eece170c3188",
      "uuidV7": "01a04291-b3d0-752e-be5a-597ed7f4ba9b",
      "title": [
        {
          "@value": "approvalはtool、normalized args、target、amount/content digest、expiryにbindされ",
          "@language": "ja"
