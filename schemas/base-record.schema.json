{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/verifiable-offline-webmcp-agent/schemas/base-record.schema.json",
  "title": "Bilingual Open-Knowledge-Style Record",
  "type": "object",
  "required": [
    "id",
    "identity",
    "temporal",
    "title",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid_v5",
        "uuid_v7",
        "uuid_namespace",
        "canonical_name",
        "category"
      ],
      "properties": {
        "uuid_v5": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "uuid_v7": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "uuid_namespace": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "canonical_name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "updated_at",
        "observed_at",
        "valid_from",
        "epoch_ms",
        "time_zone",
        "local_time_zone",
        "local_rendering",
        "precision",
        "standard"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "epoch_ms": {
          "type": "integer",
          "minimum": 0
        },
        "time_zone": {
          "const": "UTC"
        },
        "local_time_zone": {
          "type": "string"
        },
        "local_rendering": {
          "type": "string",
          "format": "date-time"
        },
        "precision": {
          "enum": [
            "millisecond",
            "second",
            "day",
            "year"
          ]
        },
        "standard": {
          "type": "string"
        }
      }
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ja",
        "en"
      ],
      "properties": {
        "ja": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "type": {
      "type": "string"
    }
  }
}
