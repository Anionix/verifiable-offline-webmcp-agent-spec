{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Anionix/verifiable-offline-webmcp-agent-spec/schemas/demo-video-production.schema.json",
  "$comment": "information_uuid_v5=befe51ac-d842-523a-83ba-91290fa1301d event_uuid_v7=01a04c90-5270-7d87-ad50-d7f95b7ba56d state_transition=PUBLICATION_READBACK_VERIFIED -> UPLOAD_ARTIFACT_BOUND_TO_PUBLIC_VIDEO occurred_at=2026-08-29T08:08:41.840Z machine-contract=public video evidence must bind the selected upload artifact identifier path and SHA-256 to the public YouTube video identifier instead of relying on duration alone",
  "title": "Demo video production provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "identity", "updatedAt", "stateTransition", "billingBoundary", "mediaCapabilities", "assets", "productionFiles", "productionPlan", "publication"],
  "properties": {
    "$schema": { "const": "../schemas/demo-video-production.schema.json" },
    "identity": { "$ref": "#/$defs/identity" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "stateTransition": { "type": "string", "minLength": 3 },
    "billingBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["additionalPurchaseAuthorized", "subscriptionChangeAuthorized", "higgsfieldTrialStateSource", "startingCredits", "estimatedCredits", "unlimitedAllowanceAvailable"],
      "properties": {
        "additionalPurchaseAuthorized": { "const": false },
        "subscriptionChangeAuthorized": { "const": false },
        "higgsfieldTrialStateSource": { "type": "string", "minLength": 3 },
        "startingCredits": { "type": "number", "minimum": 0 },
        "estimatedCredits": { "type": "number", "minimum": 0 },
        "unlimitedAllowanceAvailable": { "type": "boolean" }
      }
    },
    "mediaCapabilities": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/mediaCapability" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "productionFiles": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/productionFile" }
    },
    "productionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plannedDurationSeconds", "plannedActualSiteRecordingSeconds", "plannedActualSiteRecordingPermille", "voiceState", "captionTimingState"],
      "properties": {
        "plannedDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 179 },
        "plannedActualSiteRecordingSeconds": { "type": "integer", "minimum": 1, "maximum": 179 },
        "plannedActualSiteRecordingPermille": { "type": "integer", "minimum": 700, "maximum": 1000 },
        "voiceState": { "enum": ["NOT_GENERATED", "GENERATED", "MEASURED"] },
        "captionTimingState": { "enum": ["PROVISIONAL", "AUDIO_TIMED_PENDING_FINAL_VIDEO", "FINAL_VIDEO_VERIFIED"] }
      }
    },
    "publication": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["youtubeUrl", "status", "requiresSeparateApproval"],
          "properties": {
            "youtubeUrl": { "const": null },
            "status": { "const": "NOT_STARTED" },
            "requiresSeparateApproval": { "const": true }
          }
        },
        { "$ref": "#/$defs/publishedPublication" }
      ]
    }
  },
  "$defs": {
    "publishedPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationId",
        "observationUuidV7",
        "youtubeUrl",
        "videoId",
        "channelId",
        "status",
        "visibility",
        "publishedAt",
        "observedAt",
        "requiresSeparateApproval",
        "approvalState",
        "uploadArtifactBinding",
        "anonymousReadback",
        "subtitles",
        "thumbnail",
        "devpostReadback"
      ],
      "properties": {
        "publicationId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "observationUuidV7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "youtubeUrl": { "type": "string", "pattern": "^https://youtu\\.be/[A-Za-z0-9_-]{11}$" },
        "videoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
        "channelId": { "type": "string", "pattern": "^UC[A-Za-z0-9_-]{22}$" },
        "status": { "const": "PUBLIC_VERIFIED" },
        "visibility": { "const": "PUBLIC" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "observedAt": { "type": "string", "format": "date-time" },
        "requiresSeparateApproval": { "const": true },
        "approvalState": { "const": "GRANTED" },
        "uploadArtifactBinding": { "$ref": "#/$defs/youtubeUploadArtifactBinding" },
        "anonymousReadback": { "$ref": "#/$defs/youtubeAnonymousReadback" },
        "subtitles": { "$ref": "#/$defs/youtubeSubtitleReadback" },
        "thumbnail": { "$ref": "#/$defs/youtubeThumbnailReadback" },
        "devpostReadback": { "$ref": "#/$defs/devpostVideoReadback" }
      }
    },
    "youtubeUploadArtifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingId", "observationUuidV7", "observedAt", "localArtifactId", "localPath", "localSha256", "youtubeVideoId", "state", "evidence"],
      "properties": {
        "bindingId": { "const": "f49ce1a1-e36f-5ecf-923f-2746676933cf" },
        "observationUuidV7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "observedAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
        "localArtifactId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "localPath": { "const": ".local/video-production/webmcp-hotel-demo-final-v10.mp4" },
        "localSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "youtubeVideoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
        "state": { "const": "SELECTED_UPLOAD_ARTIFACT_BOUND_TO_PUBLIC_VIDEO" },
        "evidence": { "type": "string", "minLength": 80 }
      }
    },
    "youtubeAnonymousReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["httpStatus", "oEmbedTitle", "playabilityStatus", "playableInEmbed", "isPrivate", "isUnlisted", "durationSeconds"],
      "properties": {
        "httpStatus": { "const": 200 },
        "oEmbedTitle": { "const": "WebMCP vs Duplicate Bookings: A Live Demo" },
        "playabilityStatus": { "const": "OK" },
        "playableInEmbed": { "const": true },
        "isPrivate": { "const": false },
        "isUnlisted": { "const": false },
        "durationSeconds": { "const": 150 }
      }
    },
    "youtubeSubtitleReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["englishAutomatic", "japaneseAuthored"],
      "properties": {
        "englishAutomatic": { "const": "PUBLISHED" },
        "japaneseAuthored": { "const": "PUBLISHED" }
      }
    },
    "youtubeThumbnailReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canvaAssetSha256", "customApplicationState", "failureReason", "publicState", "publicUrl", "publicSha256", "publicWidth", "publicHeight"],
      "properties": {
        "canvaAssetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "customApplicationState": { "const": "NOT_APPLIED_TOOL_TIMEOUT" },
        "failureReason": { "const": "YOUTUBE_FILE_CHOOSER_TIMEOUT" },
        "publicState": { "const": "AUTO_GENERATED_PUBLIC_VERIFIED" },
        "publicUrl": { "type": "string", "pattern": "^https://i\\.ytimg\\.com/vi/[A-Za-z0-9_-]{11}/maxresdefault\\.jpg$" },
        "publicSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "publicWidth": { "const": 1280 },
        "publicHeight": { "const": 720 }
      }
    },
    "devpostVideoReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["informationUuidV5", "observationUuidV7", "observedAt", "projectId", "projectSlug", "projectState", "projectName", "videoUrl", "updateResponseVersion", "challengeSlug", "submittedAt", "finalSubmissionState"],
      "properties": {
        "informationUuidV5": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "observationUuidV7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "observedAt": { "type": "string", "format": "date-time" },
        "projectId": { "const": 1405191 },
        "projectSlug": { "const": "project-y79pb23hj1mz" },
        "projectState": { "const": "published" },
        "projectName": { "const": "未定" },
        "videoUrl": { "type": "string", "pattern": "^https://youtu\\.be/[A-Za-z0-9_-]{11}$" },
        "updateResponseVersion": { "type": "integer", "minimum": 1 },
        "challengeSlug": { "const": "webmcp" },
        "submittedAt": { "const": null },
        "finalSubmissionState": { "const": "NOT_SUBMITTED" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["informationUuidV5", "observationUuidV7"],
      "properties": {
        "informationUuidV5": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "observationUuidV7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "service", "kind", "status", "prompt", "createdAt", "remoteId", "localPath", "sha256", "disclosure"],
      "properties": {
        "assetId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "service": { "enum": ["Higgsfield", "OpenArt", "Magnific", "vidIQ", "HeyGen", "Canva", "LOCAL"] },
        "kind": { "enum": ["REFERENCE_IMAGE", "VIDEO_SCENE", "VOICE", "SUBTITLE", "TITLE_SET", "THUMBNAIL", "SCREEN_CAPTURE", "SCREEN_RECORDING", "FINAL_VIDEO"] },
        "status": { "enum": ["PLANNED", "SUBMITTED", "COMPLETED", "FAILED", "SKIPPED", "UNMEASURED"] },
        "prompt": { "type": ["string", "null"] },
        "createdAt": { "type": ["string", "null"], "format": "date-time" },
        "remoteId": { "type": ["string", "null"] },
        "localPath": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "disclosure": { "type": "string", "minLength": 3 },
        "voiceEvidence": { "$ref": "#/$defs/voiceEvidence" },
        "subtitleEvidence": { "$ref": "#/$defs/subtitleEvidence" },
        "videoEvidence": { "$ref": "#/$defs/videoEvidence" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "VOICE" } }, "required": ["kind"] },
          "then": { "required": ["voiceEvidence"] },
          "else": { "not": { "required": ["voiceEvidence"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "SUBTITLE" } }, "required": ["kind"] },
          "then": { "required": ["subtitleEvidence"] },
          "else": { "not": { "required": ["subtitleEvidence"] } }
        },
        {
          "if": {
            "properties": {
              "kind": { "enum": ["SCREEN_RECORDING", "FINAL_VIDEO"] },
              "status": { "const": "COMPLETED" }
            },
            "required": ["kind", "status"]
          },
          "then": {
            "required": ["videoEvidence"],
            "properties": {
              "localPath": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "else": { "not": { "required": ["videoEvidence"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "FINAL_VIDEO" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "service": { "const": "LOCAL" },
              "status": { "const": "COMPLETED" },
              "remoteId": { "const": null },
              "videoEvidence": {
                "allOf": [
                  { "$ref": "#/$defs/videoEvidence" },
                  {
                    "properties": {
                      "width": { "const": 1920 },
                      "height": { "const": 1080 },
                      "hasAudio": { "const": true },
                      "englishCaptionsBurned": { "const": true }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "service": { "const": "LOCAL" } }, "required": ["service"] },
          "then": { "properties": { "remoteId": { "const": null } } }
        }
      ]
    },
    "voiceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voiceId", "voiceName", "voiceType", "voiceCloneUsed", "avatarUsed", "durationSeconds", "byteLength", "codec", "sampleRateHertz", "channels", "audioUrlObjectId", "providerObjectLastModifiedAt", "generationRequestId", "generationRequestIdState"],
      "properties": {
        "voiceId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "voiceName": { "const": "Annie - Lifelike" },
        "voiceType": { "const": "STOCK_PUBLIC" },
        "voiceCloneUsed": { "const": false },
        "avatarUsed": { "const": false },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 179 },
        "byteLength": { "type": "integer", "minimum": 1 },
        "codec": { "const": "mp3" },
        "sampleRateHertz": { "const": 44100 },
        "channels": { "const": 1 },
        "audioUrlObjectId": { "type": "string", "format": "uuid" },
        "providerObjectLastModifiedAt": { "type": "string", "format": "date-time" },
        "generationRequestId": { "type": "null" },
        "generationRequestIdState": { "const": "NOT_RETAINED" }
      }
    },
    "subtitleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceAudioAssetId", "timingMethod", "authoredTextAligned", "similarity", "timedWords", "captionCount", "remoteMediaId", "observedAt", "finalVideoVerified"],
      "properties": {
        "sourceAudioAssetId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "timingMethod": { "enum": ["FASTER_WHISPER_LOCAL", "AUTHORED_TRANSLATION_ON_AUDIO_TIMED_CUES"] },
        "authoredTextAligned": { "const": true },
        "similarity": { "type": ["number", "null"], "minimum": 0.9, "maximum": 1 },
        "timedWords": { "type": ["integer", "null"], "minimum": 1 },
        "captionCount": { "type": "integer", "minimum": 1 },
        "remoteMediaId": { "type": ["string", "null"], "format": "uuid" },
        "observedAt": { "type": "string", "format": "date-time" },
        "finalVideoVerified": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "timingMethod": { "const": "FASTER_WHISPER_LOCAL" } }, "required": ["timingMethod"] },
          "then": {
            "properties": {
              "similarity": { "type": "number", "minimum": 0.9, "maximum": 1 },
              "timedWords": { "type": "integer", "minimum": 1 },
              "remoteMediaId": { "type": "string", "format": "uuid" }
            }
          }
        },
        {
          "if": { "properties": { "timingMethod": { "const": "AUTHORED_TRANSLATION_ON_AUDIO_TIMED_CUES" } }, "required": ["timingMethod"] },
          "then": {
            "properties": {
              "similarity": { "const": null },
              "timedWords": { "const": null },
              "remoteMediaId": { "const": null }
            }
          }
        }
      ]
    },
    "videoEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationSeconds", "width", "height", "frameRate", "hasAudio", "englishCaptionsBurned", "siteRecordingSeconds", "actualSiteRecordingPermille", "verifiedAt"],
      "properties": {
        "durationSeconds": { "type": "number", "minimum": 1, "maximum": 179 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "frameRate": { "type": "number", "exclusiveMinimum": 0 },
        "hasAudio": { "type": "boolean" },
        "englishCaptionsBurned": { "type": "boolean" },
        "siteRecordingSeconds": { "type": "number", "minimum": 1, "maximum": 179 },
        "actualSiteRecordingPermille": { "type": "integer", "minimum": 700, "maximum": 1000 },
        "verifiedAt": { "type": "string", "format": "date-time" }
      }
    },
    "productionFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileId", "kind", "path", "sha256", "status", "requiresAudioRetiming"],
      "properties": {
        "fileId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "kind": { "enum": ["STORYBOARD", "NARRATION_EN", "SUBTITLES_EN", "SUBTITLES_JA"] },
        "path": { "type": "string", "pattern": "^media/demo-video/[A-Za-z0-9._-]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": { "enum": ["DRAFT", "TIMED_DRAFT", "FINAL"] },
        "requiresAudioRetiming": { "type": "boolean" }
      }
    },
    "mediaCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "service", "localPluginState", "taskAttachmentState", "taskCallable", "callableToolCount", "authenticationState", "verifiedOperations", "productionUseState", "reasonCode"],
      "properties": {
        "capabilityId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "service": { "enum": ["Higgsfield", "OpenArt", "Magnific", "vidIQ", "HeyGen", "Canva"] },
        "localPluginState": { "enum": ["INSTALLED_ENABLED", "NOT_INSTALLED"] },
        "taskAttachmentState": { "const": "ATTACHED" },
        "taskCallable": { "const": true },
        "callableToolCount": { "type": "integer", "minimum": 1 },
        "authenticationState": { "enum": ["CONFIRMED", "UNVERIFIED"] },
        "verifiedOperations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(READ|WRITE):[a-z][a-z0-9_.:-]*$" }
        },
        "productionUseState": { "enum": ["USED", "NOT_USED"] },
        "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      }
    }
  }
}
