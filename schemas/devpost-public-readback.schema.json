        "invariants": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyText"
          }
        }
      }
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventUuidV7", "occurredAt", "from", "to", "evidence"],
