    },
    "submissionReceipt": {
      "$ref": "#/$defs/submissionReceipt"
    },
    "security": {
      "$ref": "#/$defs/security"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "authenticatedReadback": {
            "properties": {
              "project": {
                "properties": {
                  "challenge": {
                    "properties": {
                      "submissionState": { "const": "FINAL_SUBMISSION_NOT_PROVEN" }
                    },
                    "required": ["submissionState"]
                  }
                },
                "required": ["challenge"]
              }
            },
            "required": ["project"]
          }
        },
        "required": ["authenticatedReadback"]
      },
      "then": {
        "not": { "required": ["submissionReceipt"] }
      },
      "else": {
        "required": ["submissionReceipt"]
      }
    }
  ],
  "$defs": {
    "uuidV5": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "millisecondDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "profile"],
