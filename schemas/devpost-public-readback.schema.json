        },
        "version": {
          "const": "0.2"
        },
        "profile": {
          "const": "devpost-public-readback"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespaceUuidV5", "uuidV5Name", "informationUuidV5", "observationUuidV7", "observedAt"],
