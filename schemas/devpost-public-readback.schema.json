{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Anionix/verifiable-offline-webmcp-agent-spec/schemas/devpost-public-readback.schema.json",
  "$comment": "information_uuid_v5=5239a2c0-d589-56b8-b380-358a07f5f58a schema_event_uuid_v7=01a04d9a-1a20-71af-a6b1-080b61f1f60c record_information_uuid_v5=0c07e0df-d0fe-5ea5-8967-b7263738ab69 state_transition=LOCALLY_EDITABLE_VERIFIED_FIELDS -> DEVPOST_TOOL_RECEIPT_AND_AUTHENTICATED_READBACK_BOUND occurred_at=2026-08-29T12:59:00.000Z machine-contract=a verified final submission requires both a Devpost submit-project receipt and an authenticated project readback with matching submitted time and URL while pending evidence forbids any submission receipt",
  "title": "Devpost public readback evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format",
    "identity",
    "preparedFromCommit",
    "machineContract",
    "updateReceipt",
    "authenticatedReadback",
    "anonymousPublicHtml",
    "uploadedAssetReadback",
    "security"
  ],
  "properties": {
