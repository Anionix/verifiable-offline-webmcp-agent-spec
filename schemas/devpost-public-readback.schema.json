        "uuidV5Name": {
          "const": "evidence/devpost-public-readback-project-1405191-version-11"
        },
        "informationUuidV5": {
          "$ref": "#/$defs/uuidV5",
          "const": "0c07e0df-d0fe-5ea5-8967-b7263738ab69"
        },
        "observationUuidV7": {
          "$ref": "#/$defs/uuidV7"
        },
        "observedAt": {
          "$ref": "#/$defs/millisecondDateTime"
        }
      }
    },
    "machineContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateTransition", "invariants"],
      "properties": {
        "stateTransition": {
          "$ref": "#/$defs/stateTransition"
