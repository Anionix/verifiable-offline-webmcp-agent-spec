        "to": {
          "enum": ["PUBLIC_OPEN_GRAPH_STALE_AND_IMAGE_ASSOCIATION_INCONCLUSIVE", "FINAL_SUBMISSION_VERIFIED"]
        },
        "evidence": {
          "$ref": "#/$defs/nonEmptyText"
        }
      }
    },
    "updateReceipt": {
