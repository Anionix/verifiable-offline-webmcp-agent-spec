      "const": "../schemas/devpost-public-readback.schema.json"
    },
    "format": {
      "$ref": "#/$defs/format"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "preparedFromCommit": {
      "const": "037496f6db7281b7b1a9ecd9b3dfc71d407feeb6"
    },
    "machineContract": {
      "$ref": "#/$defs/machineContract"
    },
    "updateReceipt": {
      "$ref": "#/$defs/updateReceipt"
    },
    "authenticatedReadback": {
      "$ref": "#/$defs/authenticatedReadback"
    },
    "anonymousPublicHtml": {
      "$ref": "#/$defs/anonymousPublicHtml"
    },
