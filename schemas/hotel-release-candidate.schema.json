{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Anionix/verifiable-offline-webmcp-agent-spec/schemas/hotel-release-candidate.schema.json",
  "$comment": "information_uuid_v5=f2da6444-7447-5120-a39d-446adda200ca event_uuid_v7=01a052db-1fd7-7f69-a40f-540e4dc061a8 state_transition=LOCAL_LIVENESS_PROVED -> PUBLIC_WEBMCP_RELEASE_READY occurred_at=2026-08-30T13:28:07.383Z event_uuid_v7=01a05601-4f10-7b6d-9c28-8e8ccf22e2a1 state_transition=COMMITTED_CANDIDATE -> WORKTREE_CANDIDATE_EXPLICITLY_UNPUBLISHED occurred_at=2026-08-31T05:13:10.000Z machine-contract=the release candidate may retain a historical public readback while local artifact hashes differ, but that state must be explicit and must not be presented as a newly deployed release.",
  "description": "This schema checks structure. Accepting PASS additionally requires node scripts/validate_hotel_release_candidate.mjs --check. Its native binding validation and compareStable step reject candidate reconciliation values unrelated to the separately loaded native call results. Schema-only validation is not semantic acceptance.",
  "title": "Hotel release candidate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "identity",
    "observedAt",
    "source",
    "testRun",
    "localLiveness",
    "artifacts",
    "publicClaims",
    "browserObservation",
    "issueReadiness",
    "finalGate"
  ],
  "properties": {
    "$schema": { "const": "../schemas/hotel-release-candidate.schema.json" },
    "identity": { "$ref": "#/$defs/identity" },
    "observedAt": { "$ref": "#/$defs/observedAt" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "state", "branch", "baseCommit"],
      "properties": {
        "commit": { "$ref": "#/$defs/commit" },
        "state": { "enum": ["COMMITTED_CANDIDATE", "WORKTREE_CANDIDATE"] },
        "branch": { "type": "string", "minLength": 1 },
        "baseCommit": { "$ref": "#/$defs/commit" }
      }
    },
    "testRun": { "$ref": "#/$defs/testRun" },
    "localLiveness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stateSequence", "sameIntent", "physicalBookingRows", "effectStartCount", "approvalDigestRenewed"],
      "properties": {
        "status": { "const": "PASS" },
        "stateSequence": { "const": ["PREPARED", "EXPIRED", "PREPARED", "HUMAN_APPROVED", "COMMITTED"] },
        "sameIntent": { "const": true },
        "physicalBookingRows": { "const": 1 },
        "effectStartCount": { "const": 1 },
        "approvalDigestRenewed": { "const": true }
      }
    },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "publicClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateTestCount", "publicReadbackTestCount", "status", "source", "releaseCommit", "deploymentId", "publicUrl"],
      "properties": {
        "candidateTestCount": { "type": "integer", "minimum": 1 },
        "publicReadbackTestCount": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["MATCH", "PUBLIC_READBACK_TEST_COUNT_MATCH_ARTIFACTS_UNPUBLISHED"] },
        "source": { "const": "metadata/hotel-public-release-readback.json" },
        "releaseCommit": { "$ref": "#/$defs/commit" },
        "deploymentId": { "$ref": "#/$defs/deploymentId" },
        "publicUrl": { "type": "string", "format": "uri", "pattern": "^https://[a-z0-9-]+\\.vercel\\.app/?$" }
      }
    },
    "browserObservation": {
      "oneOf": [{ "$ref": "#/$defs/browserObservation" }, { "$ref": "#/$defs/managedBrowserObservation" }]
    },
    "issueReadiness": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "status", "reason"],
        "properties": {
          "issue": { "enum": [189, 190, 191, 192, 193] },
          "status": { "const": "PASS" },
          "reason": { "type": "string", "minLength": 3 }
        }
      }
    },
    "finalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula", "status", "ready", "components"],
      "properties": {
        "formula": { "const": "S AND L AND F_exact AND W AND E" },
        "status": { "const": "PASS" },
        "ready": { "const": true },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["S", "L", "F_exact", "W", "E"],
          "properties": {
            "S": { "const": "PASS" },
            "L": { "const": "PASS" },
            "F_exact": { "const": "PASS" },
            "W": { "const": "PASS" },
            "E": { "const": "PASS" }
          }
        }
      }
    }
  },
  "$defs": {
    "uuidV5": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "uuidV7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "observedAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "deploymentId": { "type": "string", "pattern": "^dpl_[A-Za-z0-9]+$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["informationUuidV5", "observationUuidV7"],
      "properties": {
        "informationUuidV5": { "$ref": "#/$defs/uuidV5" },
        "observationUuidV7": { "$ref": "#/$defs/uuidV7" }
      }
    },
    "testRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "directory", "passed", "failed", "skipped", "total", "derivedFrom"],
      "properties": {
        "command": { "const": "npm test" },
        "directory": { "const": "src/typescript" },
        "passed": { "type": "integer", "minimum": 1 },
        "failed": { "const": 0 },
        "skipped": { "const": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "derivedFrom": { "const": "node-test-summary" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functionalClientSha256", "functionalClientScope", "fullClientSha256", "fullClientScope", "fullSitesPackageSha256", "fullSitesScope"],
      "properties": {
        "functionalClientSha256": { "$ref": "#/$defs/sha256" },
        "functionalClientScope": {
          "const": {
            "algorithm": "SHA-256",
            "root": "dist/client",
            "canonicalization": "LEXICOGRAPHIC_RELATIVE_POSIX_PATH_NUL_FILE_BYTES_NUL",
            "excludedPaths": [".assetsignore", "service-integrations.json"]
          }
        },
        "fullClientSha256": { "$ref": "#/$defs/sha256" },
        "fullClientScope": {
          "const": {
            "algorithm": "SHA-256",
            "root": "dist/client",
            "canonicalization": "LEXICOGRAPHIC_RELATIVE_POSIX_PATH_NUL_FILE_BYTES_NUL",
            "excludedPaths": []
          }
        },
        "fullSitesPackageSha256": { "$ref": "#/$defs/sha256" },
        "fullSitesScope": {
          "const": {
            "algorithm": "SHA-256",
            "root": "dist",
            "canonicalization": "LEXICOGRAPHIC_RELATIVE_POSIX_PATH_NUL_FILE_BYTES_NUL",
            "excludedPaths": []
          }
        }
      }
    },
    "effectCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bookingCount", "effectStartCount", "externalRequests", "permissionRequests", "notifications"],
      "properties": {
        "bookingCount": { "const": 0 },
        "effectStartCount": { "const": 0 },
        "externalRequests": { "const": 0 },
        "permissionRequests": { "const": 0 },
        "notifications": { "const": 0 }
      }
    },
    "statusResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolName", "state", "bookingExists", "confirmationNumber", "attemptCount", "bookingCount", "effectStartCount"],
      "properties": {
        "toolName": { "const": "get_hotel_booking_status" },
        "state": { "enum": ["COMMITTED", "RETRY_RECOGNIZED"] },
        "bookingExists": { "const": true },
        "confirmationNumber": { "type": "string", "pattern": "^FKR-[A-Z0-9]+$" },
        "attemptCount": { "type": "integer", "minimum": 1, "maximum": 2 },
        "bookingCount": { "const": 1 },
        "effectStartCount": { "const": 1 },
        "intentId": { "$ref": "#/$defs/uuidV5" },
        "fingerprint": { "$ref": "#/$defs/uuidV5" },
        "bookingId": { "$ref": "#/$defs/uuidV5" },
        "eventCount": { "type": "integer", "minimum": 1 },
        "eventChainHead": { "$ref": "#/$defs/sha256" }
      }
    },
    "legacyStatusResult": {
      "allOf": [
        { "$ref": "#/$defs/statusResult" },
        {
          "not": {
            "anyOf": [
              { "required": ["intentId"] },
              { "required": ["fingerprint"] },
              { "required": ["bookingId"] },
              { "required": ["eventCount"] },
              { "required": ["eventChainHead"] }
            ]
          }
        }
      ]
    },
    "finalStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "attemptCount", "bookingCount", "effectStartCount", "confirmationNumber", "sameConfirmation"],
      "properties": {
        "state": { "const": "RETRY_RECOGNIZED" },
        "attemptCount": { "const": 2 },
        "bookingCount": { "const": 1 },
        "effectStartCount": { "const": 1 },
        "confirmationNumber": { "type": "string", "pattern": "^FKR-[A-Z0-9]+$" },
        "sameConfirmation": { "const": true },
        "intentId": { "$ref": "#/$defs/uuidV5" },
        "fingerprint": { "$ref": "#/$defs/uuidV5" },
        "bookingId": { "$ref": "#/$defs/uuidV5" },
        "eventCount": { "type": "integer", "minimum": 1 },
        "eventChainHead": { "$ref": "#/$defs/sha256" }
      }
    },
    "legacyFinalStatus": {
      "allOf": [
        { "$ref": "#/$defs/finalStatus" },
        {
          "not": {
            "anyOf": [
              { "required": ["intentId"] },
              { "required": ["fingerprint"] },
              { "required": ["bookingId"] },
              { "required": ["eventCount"] },
              { "required": ["eventChainHead"] }
            ]
          }
        }
      ]
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path", "sha256", "durationSeconds"],
      "properties": {
        "status": { "const": "LOCAL_ARTIFACT" },
        "path": { "type": "string", "pattern": "^/[^\\n]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 180 }
      }
    },
    "browserObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "origin",
        "observedAt",
        "browser",
        "secureContext",
        "pageSourceCommit",
        "candidateSourceCommit",
        "documentModelContext",
        "requiredChromeFlags",
        "configurationState",
        "launchArguments",
        "devtoolsWebmcpCategory",
        "originTrialMetadataCount",
        "visibleToolNames",
        "forbiddenToolNames",
        "calledToolNames",
        "discoveryEffectCounts",
        "reconciliation",
        "recording",
        "status"
      ],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://[a-z0-9-]+\\.vercel\\.app/?$" },
        "origin": { "type": "string", "format": "uri", "pattern": "^https://[a-z0-9-]+\\.vercel\\.app$" },
        "observedAt": { "$ref": "#/$defs/observedAt" },
        "browser": { "type": "string", "minLength": 1 },
        "secureContext": { "const": true },
        "pageSourceCommit": { "$ref": "#/$defs/commit" },
        "candidateSourceCommit": { "$ref": "#/$defs/commit" },
        "documentModelContext": { "const": "CONFIRMED_PRESENT" },
        "requiredChromeFlags": { "const": ["#devtools-webmcp-support", "#enable-webmcp-testing"] },
        "configurationState": { "const": "VERIFIED" },
        "launchArguments": { "const": ["--enable-features=WebMCP"] },
        "devtoolsWebmcpCategory": { "const": true },
        "originTrialMetadataCount": { "const": 0 },
        "visibleToolNames": { "const": ["check_existing_hotel_booking", "prepare_hotel_booking", "get_hotel_booking_status", "preview_hotel_cancellation"] },
        "forbiddenToolNames": { "const": ["confirm_hotel_booking", "pay_for_hotel_booking", "cancel_hotel_booking"] },
        "calledToolNames": { "const": ["check_existing_hotel_booking", "prepare_hotel_booking", "get_hotel_booking_status"] },
        "discoveryEffectCounts": { "$ref": "#/$defs/effectCounts" },
        "reconciliation": {
          "allOf": [
            { "$ref": "#/$defs/browserReconciliation" },
            {
              "properties": {
                "statusCheck": { "$ref": "#/$defs/legacyStatusResult" },
                "finalStatus": { "$ref": "#/$defs/legacyFinalStatus" }
              }
            }
          ]
        },
        "recording": { "$ref": "#/$defs/recording" },
        "status": { "const": "PASS" }
      }
    },
    "browserReconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "flow", "statusCheck", "finalStatus", "sameConfirmation", "humanConfirmationBoundary", "driverAction", "agentExplanation"],
      "properties": {
        "status": { "const": "PASS" },
        "flow": { "const": ["AMBIGUOUS_OUTCOME", "AGENT_WEBMCP_STATUS_CHECK", "EXISTING_RESULT_FOUND", "NO_DUPLICATE_EFFECT"] },
        "statusCheck": { "$ref": "#/$defs/statusResult" },
        "finalStatus": { "$ref": "#/$defs/finalStatus" },
        "sameConfirmation": { "const": true },
        "humanConfirmationBoundary": { "const": "visible_button_only" },
        "driverAction": { "const": "visible_button_exercised_by_browser_driver" },
        "agentExplanation": { "type": "string", "minLength": 50 }
      }
    },
    "managedBrowserReconciliationStatusResult": {
      "allOf": [
        { "$ref": "#/$defs/statusResult" },
        {
          "required": ["intentId", "fingerprint", "bookingId", "eventCount", "eventChainHead"],
          "properties": {
            "state": { "const": "COMMITTED" },
            "attemptCount": { "const": 1 },
            "eventCount": { "const": 3 }
          }
        }
      ]
    },
    "managedBrowserReconciliationFinalStatus": {
      "allOf": [
        { "$ref": "#/$defs/finalStatus" },
        {
          "required": ["intentId", "fingerprint", "bookingId", "eventCount", "eventChainHead"],
          "properties": {
            "eventCount": { "const": 4 }
          }
        }
      ]
    },
    "managedBrowserReconciliation": {
      "allOf": [
        { "$ref": "#/$defs/browserReconciliation" },
        {
          "required": ["statusCheck", "finalStatus"],
          "properties": {
            "statusCheck": { "$ref": "#/$defs/managedBrowserReconciliationStatusResult" },
            "finalStatus": { "$ref": "#/$defs/managedBrowserReconciliationFinalStatus" }
          }
        }
      ]
    },
    "managedBrowserObservation": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "information_uuid_v5=a0fbdc59-0d0e-5134-89b8-1d30db405e5a event_uuid_v7=01a05439-6770-7ee3-a4cf-7ac7d7ea90ef state_transition=MANAGED_NATIVE_CAPABILITY_VALIDATED -> CANDIDATE_BROWSER_OBSERVATION_BOUND occurred_at=2026-08-30T19:50:43.312Z machine-contract=The managed discovery profile is bound to the existing candidate source, test, artifact, reconciliation, and recording gates; Chrome configuration remains unmeasured.",
      "required": [
        "profile",
        "url",
        "origin",
        "observedAt",
        "pageSourceCommit",
        "candidateSourceCommit",
        "visibleToolNames",
        "forbiddenToolNames",
        "managedDiscovery",
        "reconciliation",
        "recording",
        "status"
      ],
      "properties": {
        "profile": { "const": "MANAGED_IAB_NATIVE_CAPABILITY_V1" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://[a-z0-9-]+\\.vercel\\.app/?$" },
        "origin": { "type": "string", "format": "uri", "pattern": "^https://[a-z0-9-]+\\.vercel\\.app$" },
        "observedAt": { "$ref": "#/$defs/observedAt" },
        "pageSourceCommit": { "$ref": "#/$defs/commit" },
        "candidateSourceCommit": { "$ref": "#/$defs/commit" },
        "visibleToolNames": { "const": ["check_existing_hotel_booking", "prepare_hotel_booking", "get_hotel_booking_status", "preview_hotel_cancellation"] },
        "forbiddenToolNames": { "const": ["confirm_hotel_booking", "pay_for_hotel_booking", "cancel_hotel_booking"] },
        "managedDiscovery": {
          "$ref": "https://github.com/Anionix/verifiable-offline-webmcp-agent-spec/schemas/hotel-native-webmcp-reconciliation.schema.json#/$defs/managedDiscovery"
        },
        "reconciliation": { "$ref": "#/$defs/managedBrowserReconciliation" },
        "recording": { "$ref": "#/$defs/recording" },
        "status": { "const": "PASS" }
      }
    }
  }
}
