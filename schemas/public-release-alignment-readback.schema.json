        "projectId",
        "projectSlug",
        "state",
        "projectVersion",
        "updatedAt",
        "websiteUrl",
        "videoUrl",
        "descriptionMarkers",
        "submission"
      ],
      "properties": {
        "targetInformationUuidV5": { "$ref": "#/$defs/uuidV5" },
        "observedAt": { "$ref": "#/$defs/observedAt" },
        "url": { "type": "string", "format": "uri" },
        "projectId": { "const": "1405191" },
        "projectSlug": { "const": "project-y79pb23hj1mz" },
        "state": { "const": "published" },
        "projectVersion": { "const": 16 },
        "updatedAt": { "$ref": "#/$defs/observedAt" },
        "websiteUrl": { "type": "string", "format": "uri" },
        "videoUrl": { "type": "string", "format": "uri" },
        "descriptionMarkers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "submittedWebsite",
            "sitesVersion14",
            "vercelSourceCommit2d5",
            "vercelDeploymentHwjv",
            "testCount194",
            "exactTools",
            "forbiddenTools",
            "noOld192",
            "noOldC8be"
          ],
          "properties": {
            "submittedWebsite": { "const": true },
            "sitesVersion14": { "const": true },
            "vercelSourceCommit2d5": { "const": true },
            "vercelDeploymentHwjv": { "const": true },
            "testCount194": { "const": true },
            "exactTools": { "const": true },
            "forbiddenTools": { "const": true },
            "noOld192": { "const": true },
            "noOldC8be": { "const": true }
