  "$comment": "information_uuid_v5=bded1f61-139c-50b9-a0a1-d5f7901c2915 event_uuid_v7=01a0576f-4c85-7731-b4b3-3833d8af4a2f state_transition=PUBLIC_TARGETS_WITH_STALE_DESCRIPTION -> PUBLIC_TARGETS_AND_DESCRIPTION_ALIGNED occurred_at=2026-08-31T10:48:27.013Z machine-contract=the submitted Site, Vercel fallback, and Devpost description are checked as separate observations and only their shared public contract is aligned",
  "title": "Public release alignment readback",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "identity", "machineContract", "authorization", "previousRecord", "targets", "alignment", "limitations"],
  "properties": {
    "$schema": { "const": "../schemas/public-release-alignment-readback.schema.json" },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "profile"],
      "properties": {
        "name": { "const": "OpenKnowledgeFormat-inspired evidence record" },
        "version": { "const": "0.1" },
        "profile": { "const": "public-release-alignment" }
      }
    },
    "identity": { "$ref": "#/$defs/identity" },
    "machineContract": { "$ref": "#/$defs/machineContract" },
    "authorization": { "$ref": "#/$defs/authorization" },
