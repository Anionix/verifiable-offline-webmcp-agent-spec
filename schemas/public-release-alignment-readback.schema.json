        "forbiddenToolNames": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "attemptCount", "bookingCount", "effectStartCount", "sameConfirmation"],
