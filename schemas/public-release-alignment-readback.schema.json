            "bookingCount": { "const": 1 },
            "effectStartCount": { "const": 1 },
            "sameConfirmation": { "const": true }
          }
        }
      }
    },
    "sitesTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetInformationUuidV5",
        "observedAt",
        "url",
        "evaluationUrl",
        "statusCode",
        "authentication",
        "projectId",
        "versionId",
        "versionNumber",
        "sourceCommit",
        "providerState",
        "evaluation"
