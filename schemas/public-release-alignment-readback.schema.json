        "url": { "type": "string", "format": "uri" },
        "evaluationUrl": { "type": "string", "format": "uri" },
        "statusCode": { "const": 200 },
        "authentication": { "const": "ANONYMOUS" },
        "projectId": { "type": "string", "minLength": 1 },
        "versionId": { "type": "string", "minLength": 1 },
        "versionNumber": { "const": 14 },
        "sourceCommit": { "type": "string", "minLength": 40, "maxLength": 40 },
        "providerState": { "const": "active" },
        "evaluation": { "$ref": "#/$defs/evaluation" }
      }
    },
    "vercelTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetInformationUuidV5",
        "observedAt",
        "url",
        "evaluationUrl",
        "statusCode",
        "authentication",
        "deploymentId",
        "sourceCommit",
        "evaluation"
