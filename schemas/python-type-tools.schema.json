{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Anionix/verifiable-offline-webmcp-agent-spec/schemas/python-type-tools.schema.json",
  "$comment": "information_uuid_v5=0295e1e4-5327-5304-8f27-a63d49de4ba3 event_uuid_v7=01a04c99-d1c3-776e-9e68-78f0ce19ce97 state_transition=PYTHON_TYPE_ANALYSIS_UNCONFIGURED -> VERSION_PINNED -> PROJECT_SCOPE_CONFIGURED -> TYPE_CHECKS_PASSED -> LANGUAGE_SERVER_HANDSHAKES_VERIFIED occurred_at=2026-08-29T08:19:04.259Z machine-contract=both exact tools both project checks and both language-server handshakes must agree without global installation or generated configuration migration",
  "title": "Python type-tool integration evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "identity", "stateTransition", "installation", "projectScope", "tools", "sources", "secretsIncluded"],
  "properties": {
    "$schema": { "const": "../schemas/python-type-tools.schema.json" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["informationUuidV5", "observationUuidV7", "namespace", "observedAt"],
      "properties": {
        "informationUuidV5": { "const": "0295e1e4-5327-5304-8f27-a63d49de4ba3" },
        "observationUuidV7": { "$ref": "#/$defs/uuidV7" },
        "namespace": { "const": "47f3e535-0e27-559a-9556-aa79a84f95eb" },
        "observedAt": { "$ref": "#/$defs/observedAt" }
      }
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "through", "to", "eventId", "occurredAt", "machineContract"],
      "properties": {
        "from": { "const": "PYTHON_TYPE_ANALYSIS_UNCONFIGURED" },
        "through": { "const": ["VERSION_PINNED", "PROJECT_SCOPE_CONFIGURED", "TYPE_CHECKS_PASSED"] },
        "to": { "const": "LANGUAGE_SERVER_HANDSHAKES_VERIFIED" },
        "eventId": { "$ref": "#/$defs/uuidV7" },
        "occurredAt": { "$ref": "#/$defs/observedAt" },
        "machineContract": { "type": "string", "minLength": 120 }
      }
    },
    "installation": {
      "const": {
        "scope": "PROJECT_DEV_DEPENDENCIES",
        "manager": "uv",
        "configuration": "pyproject.toml",
        "lockfile": "uv.lock",
        "globalInstallationPerformed": false,
        "automaticPyreflyInitExecuted": false
      }
    },
    "projectScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pythonVersion", "includes", "pythonFiles"],
      "properties": {
        "pythonVersion": { "const": "3.12" },
        "includes": { "const": ["scripts", "formal/model-checker"] },
        "pythonFiles": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_./-]+\\.py$" }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "$ref": "#/$defs/ty" },
        { "$ref": "#/$defs/pyrefly" }
      ],
      "items": false
    },
    "sources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" }
    },
    "secretsIncluded": { "const": false }
  },
  "$defs": {
    "toolBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "officialStatus", "macosArm64WheelSha256", "typeCheckCommand", "typeCheckState", "languageServerCommand", "languageServerHandshakeState"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "officialStatus": { "enum": ["BETA", "STABLE"] },
        "macosArm64WheelSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "typeCheckCommand": { "type": "string" },
        "typeCheckState": { "const": "PASSED" },
        "languageServerCommand": { "type": "string" },
        "languageServerHandshakeState": { "const": "PASSED" }
      }
    },
    "ty": {
      "allOf": [
        { "$ref": "#/$defs/toolBase" },
        {
          "properties": {
            "name": { "const": "ty" },
            "version": { "const": "0.0.75" },
            "officialStatus": { "const": "BETA" },
            "macosArm64WheelSha256": { "const": "c6ccf34169821fe0d23e3360deeef981d217963412f1d087b9bdd32ec57f7a57" },
            "typeCheckCommand": { "const": "uv run --frozen ty check" },
            "languageServerCommand": { "const": "uv run --frozen ty server" }
          }
        }
      ]
    },
    "pyrefly": {
      "allOf": [
        { "$ref": "#/$defs/toolBase" },
        {
          "properties": {
            "name": { "const": "Pyrefly" },
            "version": { "const": "1.2.0" },
            "officialStatus": { "const": "STABLE" },
            "macosArm64WheelSha256": { "const": "756f669b5555090f5c1a4fef30db1785fabe657764f7e4e6dc88994dfb8ca82d" },
            "typeCheckCommand": { "const": "uv run --frozen pyrefly check --min-severity warn" },
            "languageServerCommand": { "const": "uv run --frozen pyrefly lsp" }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "title", "url", "supports"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/uuidV5" },
        "title": { "type": "string", "minLength": 3 },
        "url": { "type": "string", "format": "uri" },
        "supports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } }
      }
    },
    "uuidV5": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "uuidV7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "observedAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}
