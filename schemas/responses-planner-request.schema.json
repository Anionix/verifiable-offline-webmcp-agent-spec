{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/verifiable-offline-webmcp-agent/schemas/responses-planner-request.schema.json",
  "$comment": "information_uuid_v5=b572a396-6190-57ce-a655-fa1e1035c9d3 event_uuid_v7=01a0493d-49c1-70e8-8fdb-19acb1276a30 information_uuid_v5=d0df026b-55c2-53b2-8b98-8c4652df78b7 event_uuid_v7=01a049ff-02a9-724e-b280-7b5029b74e33 state_transition=DISCOVERED -> EXECUTING occurred_at=2026-08-28T20:10:44.265Z machine-contract=every nested tool parameter is recursively strict and closed",
  "title": "Constrained Responses Planner Request 0.5.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "input", "tools", "tool_choice", "parallel_tool_calls", "max_output_tokens", "store", "background", "safety_identifier"],
  "properties": {
    "model": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "input": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": { "const": "user" },
          "content": {
            "type": "array", "minItems": 1, "maxItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["type", "text"],
              "properties": {
                "type": { "const": "input_text" },
                "text": { "type": "string", "minLength": 2, "maxLength": 4096 }
              }
            }
          }
        }
      }
    },
    "tools": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "name", "description", "parameters", "strict"],
        "properties": {
          "type": { "const": "function" },
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
          "description": { "type": "string", "minLength": 1, "maxLength": 240 },
          "parameters": { "$ref": "#/$defs/strictObjectSchema" },
          "strict": { "const": true }
        }
      }
    },
    "tool_choice": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "mode", "tools"],
      "properties": {
        "type": { "const": "allowed_tools" },
        "mode": { "const": "required" },
        "tools": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["type", "name"],
            "properties": {
              "type": { "const": "function" },
              "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" }
            }
          }
        }
      }
    },
    "parallel_tool_calls": { "const": false },
    "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 16384 },
    "store": { "const": false },
    "background": { "const": false },
    "safety_identifier": { "$ref": "#/$defs/uuidV5" }
  },
  "$defs": {
    "uuidV5": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "strictObjectSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "additionalProperties", "properties", "required"],
      "properties": {
        "type": { "const": "object" },
        "additionalProperties": { "const": false },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
          "additionalProperties": { "$ref": "#/$defs/strictSchema" }
        },
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" }
        }
      }
    },
    "strictStringSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "string" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "enum": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "strictIntegerSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "integer" },
        "minimum": { "type": "integer" },
        "maximum": { "type": "integer" }
      }
    },
    "strictBooleanSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "boolean" } }
    },
    "strictSchema": {
      "oneOf": [
        { "$ref": "#/$defs/strictObjectSchema" },
        { "$ref": "#/$defs/strictStringSchema" },
        { "$ref": "#/$defs/strictIntegerSchema" },
        { "$ref": "#/$defs/strictBooleanSchema" }
      ]
    }
  }
}
