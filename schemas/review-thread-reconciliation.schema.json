  "required": ["$schema", "identity", "temporal", "status", "scope", "findings", "summary", "verification", "reviewUpdates", "finalVerification"],
  "properties": {
    "$schema": { "const": "../schemas/review-thread-reconciliation.schema.json" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uuidV5", "uuidV7", "namespace"],
      "properties": {
        "uuidV5": { "$ref": "#/$defs/uuidV5" },
