        "namespace": { "const": "47f3e535-0e27-559a-9556-aa79a84f95eb" }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "epochMs", "timeZone"],
      "properties": {
        "observedAt": { "type": "string", "format": "date-time" },
        "epochMs": { "type": "integer", "minimum": 0 },
        "timeZone": { "const": "UTC" }
      }
    },
    "status": { "enum": ["REVIEW", "VERIFIED"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "inspectedClosedPullRequests", "currentPullRequest", "newExternalReviewActivityAfterFinalMerge", "actualNotifications", "notificationPermissionRequests", "externalEffects"],
      "properties": {
        "repository": { "const": "Anionix/verifiable-offline-webmcp-agent-spec" },
        "inspectedClosedPullRequests": { "const": 50 },
        "currentPullRequest": { "const": 51 },
        "newExternalReviewActivityAfterFinalMerge": { "const": 17 },
        "actualNotifications": { "const": 0 },
        "notificationPermissionRequests": { "const": 0 },
        "externalEffects": { "const": 0 }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 31,
      "maxItems": 31,
      "items": { "$ref": "#/$defs/finding" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "fixedInPatch", "fixedBeforePatch", "remaining"],
      "properties": {
        "total": { "const": 31 },
        "fixedInPatch": { "const": 29 },
        "fixedBeforePatch": { "const": 2 },
        "remaining": { "const": 0 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventUuidV7", "verifiedAt", "epochMs", "stateTransition", "browserDryRunRequests", "persistedControlState", "persistedEffectState", "effectStartCount", "notificationPermission", "consoleErrors", "externalNetworkRequests"],
      "properties": {
        "eventUuidV7": { "$ref": "#/$defs/uuidV7" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "epochMs": { "const": 1787949052147 },
        "stateTransition": { "const": "REVIEW -> VERIFIED" },
        "browserDryRunRequests": { "const": 2 },
        "persistedControlState": { "const": "DRY_RUN" },
        "persistedEffectState": { "const": "NOT_STARTED" },
        "effectStartCount": { "const": 0 },
        "notificationPermission": { "const": "default" },
        "consoleErrors": { "const": 0 },
        "externalNetworkRequests": { "const": 0 }
      }
    },
    "reviewUpdates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        { "$ref": "#/$defs/reviewUpdate1" },
        { "$ref": "#/$defs/reviewUpdate2" },
        { "$ref": "#/$defs/reviewUpdate3" },
        { "$ref": "#/$defs/reviewUpdate4" },
        { "$ref": "#/$defs/reviewUpdate5" },
        { "$ref": "#/$defs/reviewUpdate6" },
        { "$ref": "#/$defs/reviewUpdate7" }
      ],
      "items": false
    },
    "finalVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventUuidV7", "verifiedAt", "epochMs", "stateTransition", "reviewFindings", "nodeTests", "repositoryChecks", "browserDryRunRequests", "persistedControlState", "persistedEffectState", "effectStartCount", "notificationPermissionRequests", "actualNotifications", "consoleErrors", "externalNetworkRequests"],
      "properties": {
        "eventUuidV7": { "$ref": "#/$defs/uuidV7" },
        "verifiedAt": { "const": "2026-08-28T22:19:05.101Z" },
        "epochMs": { "const": 1787955545101 },
        "stateTransition": { "const": "REVIEW -> VERIFIED" },
        "reviewFindings": { "const": 31 },
        "nodeTests": { "const": 111 },
        "repositoryChecks": { "const": 18 },
        "browserDryRunRequests": { "const": 4 },
        "persistedControlState": { "const": "DRY_RUN" },
        "persistedEffectState": { "const": "NOT_STARTED" },
        "effectStartCount": { "const": 0 },
        "notificationPermissionRequests": { "const": 0 },
        "actualNotifications": { "const": 0 },
        "consoleErrors": { "const": 0 },
        "externalNetworkRequests": { "const": 0 }
      }
    }
  },
  "$defs": {
    "uuidV5": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "uuidV7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "reviewUpdate1": {
      "allOf": [
        { "$ref": "#/$defs/reviewUpdate" },
        { "properties": { "observedAt": { "const": "2026-08-28T20:42:18.694Z" }, "epochMs": { "const": 1787949738694 }, "stateTransition": { "const": "VERIFIED -> REVIEW" }, "newFindings": { "const": 3 } } }
      ]
    },
    "reviewUpdate2": {
      "allOf": [
        { "$ref": "#/$defs/reviewUpdate" },
