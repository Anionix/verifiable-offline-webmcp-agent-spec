  "$id": "https://example.org/verifiable-offline-webmcp-agent/schemas/review-thread-reconciliation.schema.json",
  "$comment": "information_uuid_v5=639e8139-1107-51f4-9949-333119ddb0be event_uuid_v7=01a04a74-840d-7a37-9c02-acbe4413fec9 state_transition=REVIEW -> VERIFIED occurred_at=2026-08-28T22:19:05.101Z machine-contract=all 31 review findings map to current code and a regression check",
  "title": "Pull request review reconciliation",
  "type": "object",
