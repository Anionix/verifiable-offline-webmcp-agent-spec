      ]
    },
    "reviewUpdate3": {
      "allOf": [
        { "$ref": "#/$defs/reviewUpdate" },
        { "properties": { "observedAt": { "const": "2026-08-28T21:00:02.027Z" }, "epochMs": { "const": 1787950802027 }, "stateTransition": { "const": "REVIEW -> REVIEW" }, "newFindings": { "const": 2 } } }
      ]
    },
    "reviewUpdate4": {
      "allOf": [
        { "$ref": "#/$defs/reviewUpdate" },
        { "properties": { "observedAt": { "const": "2026-08-28T21:16:47.000Z" }, "epochMs": { "const": 1787951807000 }, "stateTransition": { "const": "VERIFIED -> REVIEW" }, "newFindings": { "const": 2 } } }
      ]
    },
    "reviewUpdate5": {
      "allOf": [
        { "$ref": "#/$defs/reviewUpdate" },
        { "properties": { "observedAt": { "const": "2026-08-28T21:34:57.000Z" }, "epochMs": { "const": 1787952897000 }, "stateTransition": { "const": "VERIFIED -> REVIEW" }, "newFindings": { "const": 3 } } }
      ]
    },
    "reviewUpdate6": {
      "allOf": [
        { "$ref": "#/$defs/reviewUpdate" },
        { "properties": { "observedAt": { "const": "2026-08-28T21:51:08.000Z" }, "epochMs": { "const": 1787953868000 }, "stateTransition": { "const": "VERIFIED -> REVIEW" }, "newFindings": { "const": 3 } } }
      ]
    },
    "reviewUpdate7": {
      "allOf": [
        { "$ref": "#/$defs/reviewUpdate" },
        { "properties": { "observedAt": { "const": "2026-08-28T21:56:03.000Z" }, "epochMs": { "const": 1787954163000 }, "stateTransition": { "const": "VERIFIED -> REVIEW" }, "newFindings": { "const": 1 } } }
      ]
    },
    "reviewUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventUuidV7", "observedAt", "epochMs", "stateTransition", "sourcePullRequest", "newFindings"],
      "properties": {
        "eventUuidV7": { "$ref": "#/$defs/uuidV7" },
        "observedAt": { "type": "string", "format": "date-time" },
        "epochMs": { "type": "integer", "minimum": 0 },
        "stateTransition": { "enum": ["VERIFIED -> REVIEW", "REVIEW -> REVIEW"] },
        "sourcePullRequest": { "const": 51 },
        "newFindings": { "type": "integer", "minimum": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["informationUuidV5", "sourcePullRequest", "reviewUrl", "severity", "title", "disposition", "fixEvidence", "testEvidence"],
      "properties": {
        "informationUuidV5": { "$ref": "#/$defs/uuidV5" },
        "sourcePullRequest": { "type": "integer", "minimum": 1 },
        "reviewUrl": { "type": "string", "format": "uri", "pattern": "^https://github.com/Anionix/verifiable-offline-webmcp-agent-spec/pull/[0-9]+#discussion_r[0-9]+$" },
        "severity": { "enum": ["P1", "P2"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "disposition": { "enum": ["FIXED_IN_PATCH", "FIXED_BEFORE_PATCH"] },
        "fixEvidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "testEvidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
