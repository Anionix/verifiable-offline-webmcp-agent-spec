{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/verifiable-offline-webmcp-agent/schemas/service-integration-registry.schema.json",
  "$comment": "information_uuid_v5=78f60de4-89ae-56bc-8e72-8ab99654c911 event_uuid_v7=01a04a91-750b-7fc7-9708-974b0c4f0c17 state_transition=RESOURCE_REVIEWED -> REGISTRY_SCHEMA_FIXED occurred_at=2026-08-28T22:50:41.000Z machine-contract=the eight official Devpost resource services have fixed identities, truthful states, illustrative-not-observed duplicate scenarios, evidence, limits, and approval boundaries",
  "title": "Service integration registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "identity",
    "temporal",
    "stateTransition",
    "commonArtifact",
    "summary",
    "localVerification",
    "services"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/service-integration-registry.schema.json"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "temporal": {
      "$ref": "#/$defs/temporal"
    },
    "stateTransition": {
      "const": "RESOURCE_REVIEWED -> INTEGRATION_CATALOGUED"
    },
    "commonArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildCommand",
        "outputDirectory",
        "sameOriginApiRequired",
        "dynamicBackendIncluded",
        "offlineAfterFirstVisit",
        "toolName"
      ],
      "properties": {
        "buildCommand": {
          "const": "npm run build:web"
        },
        "outputDirectory": {
          "const": "dist"
        },
        "sameOriginApiRequired": {
          "const": false
        },
        "dynamicBackendIncluded": {
          "const": false
        },
        "offlineAfterFirstVisit": {
          "const": true
        },
        "toolName": {
          "const": "notify_once"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalServices", "statusCounts"],
      "properties": {
        "totalServices": {
          "const": 8
        },
        "statusCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "VERIFIED",
            "CONFIGURED",
            "INCONCLUSIVE",
            "BOUNDARY_ONLY",
            "RESOURCE_CONFIRMED"
          ],
          "properties": {
            "VERIFIED": {
              "const": 0
            },
            "CONFIGURED": {
              "const": 4
            },
            "INCONCLUSIVE": {
              "const": 2
            },
            "BOUNDARY_ONLY": {
              "const": 1
            },
            "RESOURCE_CONFIRMED": {
              "const": 1
            }
          }
        }
      }
    },
    "localVerification": {
      "$ref": "#/$defs/localVerification"
    },
    "services": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {
          "$ref": "#/$defs/openai"
        },
        {
          "$ref": "#/$defs/cloudflare"
        },
        {
          "$ref": "#/$defs/vercel"
        },
        {
          "$ref": "#/$defs/shopify"
        },
        {
          "$ref": "#/$defs/googleChrome"
        },
        {
          "$ref": "#/$defs/render"
        },
        {
          "$ref": "#/$defs/netlify"
        },
        {
          "$ref": "#/$defs/devpost"
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "uuidV5": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["informationUuidV5", "eventUuidV7"],
      "properties": {
        "informationUuidV5": {
          "$ref": "#/$defs/uuidV5"
        },
        "eventUuidV7": {
          "$ref": "#/$defs/uuidV7"
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "epochMs", "timeZone"],
      "properties": {
        "observedAt": {
          "const": "2026-08-28T22:50:41.000Z"
        },
        "epochMs": {
          "const": 1787957441000
        },
        "timeZone": {
          "const": "UTC"
        }
      }
    },
    "localVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "observedAt",
        "stateTransition",
        "environment",
        "toolName",
        "toolCalls",
        "logicalOperationId",
        "intentId",
        "payloadDigest",
        "sameIntent",
        "controlState",
        "effectState",
        "effectStartCount",
        "approvalButtonClicks",
        "serviceCardCount",
        "viewportWidth",
        "horizontalOverflow",
        "browserWarningErrorCount",
        "pageModelContext",
        "nativeWebMcpConformance",
        "unexpectedApiStatus"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["informationUuidV5", "eventUuidV7"],
          "properties": {
            "informationUuidV5": { "const": "f7bf74af-23e0-5f55-aed0-b47702251250" },
            "eventUuidV7": { "const": "01a04aa6-0a41-749e-b9d0-dd06d3e9c665" }
          }
        },
        "observedAt": { "const": "2026-08-28T23:13:10.721Z" },
        "stateTransition": { "const": "INTEGRATION_CATALOGUED -> LOCAL_DUPLICATE_CHECK_VERIFIED" },
        "environment": { "const": "Codex in-app browser at http://127.0.0.1:4178" },
        "toolName": { "const": "notify_once" },
        "toolCalls": { "const": 2 },
        "logicalOperationId": { "const": "browser-double-send-001" },
        "intentId": { "const": "25a2b087-84df-545f-b744-b177d12dab05" },
        "payloadDigest": { "const": "5a9e2240c5ecadd41476b3d130000f3badedb20a2b5150363db3b3a63b0e5fd6" },
        "sameIntent": { "const": true },
        "controlState": { "const": "DRY_RUN" },
        "effectState": { "const": "NOT_STARTED" },
        "effectStartCount": { "const": 0 },
        "approvalButtonClicks": { "const": 0 },
        "serviceCardCount": { "const": 8 },
        "viewportWidth": { "const": 320 },
        "horizontalOverflow": { "const": false },
        "browserWarningErrorCount": { "const": 0 },
        "pageModelContext": { "const": "ABSENT" },
        "nativeWebMcpConformance": { "const": "INCONCLUSIVE" },
        "unexpectedApiStatus": { "const": 404 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observedAt", "statement"],
      "properties": {
        "kind": {
          "enum": [
            "DEPLOYMENT",
            "CONFIGURATION",
            "RUNTIME_OBSERVATION",
            "RESOURCE",
            "BOUNDARY"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "artifact": {
          "$ref": "#/$defs/artifactPath"
        }
      }
    },
    "artifactPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceId",
        "displayName",
        "identity",
        "status",
        "scenarioStatus",
        "duplicateRisk",
        "preventedOutcome",
        "roles",
        "sources",
        "artifacts",
        "evidence",
        "limitations",
        "approvalRequired",
        "nextAction"
      ],
      "properties": {
        "serviceId": {
          "enum": [
            "openai",
            "cloudflare",
            "vercel",
            "shopify",
            "google-chrome",
            "render",
            "netlify",
            "devpost"
          ]
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "status": {
          "enum": [
            "VERIFIED",
            "CONFIGURED",
            "INCONCLUSIVE",
            "BOUNDARY_ONLY",
            "RESOURCE_CONFIRMED"
          ]
        },
        "scenarioStatus": {
          "const": "ILLUSTRATIVE_NOT_OBSERVED"
        },
        "duplicateRisk": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "^Illustrative, not observed:"
        },
        "preventedOutcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactPath"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "approvalRequired": {
          "type": "boolean"
        },
        "nextAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "liveUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "deploymentId": {
          "type": "string",
          "pattern": "^dpl_[A-Za-z0-9]+$"
        }
      }
    },
    "openai": {
      "allOf": [
        {
          "$ref": "#/$defs/service"
        },
        {
          "properties": {
            "serviceId": {
              "const": "openai"
            },
            "status": {
              "const": "INCONCLUSIVE"
            }
          }
        }
      ]
    },
    "cloudflare": {
      "allOf": [
        {
          "$ref": "#/$defs/service"
        },
        {
          "properties": {
            "serviceId": {
              "const": "cloudflare"
            },
            "status": {
              "const": "CONFIGURED"
            }
          }
        }
      ]
    },
    "vercel": {
      "allOf": [
        {
          "$ref": "#/$defs/service"
        },
        {
          "required": ["liveUrl", "deploymentId"],
          "properties": {
            "serviceId": {
              "const": "vercel"
            },
            "status": {
              "const": "CONFIGURED"
            },
            "liveUrl": {
              "const": "https://verifiable-offline-webmcp-agent-spe.vercel.app"
            },
            "deploymentId": {
              "const": "dpl_3KTHTtZ5h8quDhviMTRo5GxBuUuE"
            }
          }
        }
      ]
    },
    "shopify": {
      "allOf": [
        {
          "$ref": "#/$defs/service"
        },
        {
          "properties": {
            "serviceId": {
              "const": "shopify"
            },
            "status": {
              "const": "BOUNDARY_ONLY"
            }
          }
        }
      ]
    },
    "googleChrome": {
      "allOf": [
        {
          "$ref": "#/$defs/service"
        },
        {
          "properties": {
            "serviceId": {
              "const": "google-chrome"
            },
            "status": {
              "const": "INCONCLUSIVE"
            }
          }
        }
      ]
    },
    "render": {
      "allOf": [
        {
          "$ref": "#/$defs/service"
        },
        {
          "properties": {
            "serviceId": {
              "const": "render"
            },
            "status": {
              "const": "CONFIGURED"
            }
          }
        }
      ]
    },
    "netlify": {
      "allOf": [
        {
          "$ref": "#/$defs/service"
        },
        {
          "properties": {
            "serviceId": {
              "const": "netlify"
            },
            "status": {
              "const": "CONFIGURED"
            }
          }
        }
      ]
    },
    "devpost": {
      "allOf": [
        {
          "$ref": "#/$defs/service"
        },
        {
          "properties": {
            "serviceId": {
              "const": "devpost"
            },
            "status": {
              "const": "RESOURCE_CONFIRMED"
            }
          }
        }
      ]
    }
  }
}
